{
  "version": 2,
  "name": "pranjay-portfolio",
  "functions": {
    "api/contact.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pranjay-dhawan.vercel.app"
        }
      ],
      "destination": "https://pd-dev.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pranjay-portfolio-pdhawan-1s-projects.vercel.app"
        }
      ],
      "destination": "https://pd-dev.vercel.app/$1",
      "permanent": true
    }
  ]
}
